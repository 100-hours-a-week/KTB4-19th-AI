# LLM_API_KEY가 없으면 OPENROUTER_API_KEY를 대신 사용합니다 (settings.py 참고)
LLM_API_KEY=
OPENROUTER_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
VLM_MODEL=z-ai/glm-5.3-flash
S3_BUCKET=
AWS_REGION=ap-northeast-2
EMBEDDING_API_URL=http://embedding:8000
# 없으면 기동을 거부합니다 (settings.py의 REQUIRED_SETTINGS)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
# 인증을 켠 Qdrant에서만 채웁니다. 비우면 헤더 없이 접속합니다
QDRANT_API_KEY=
