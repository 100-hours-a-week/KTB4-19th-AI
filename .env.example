# Pod가 꺼졌거나 호출에 실패하면 OpenRouter로 전환합니다.
ACTIVE_MODEL_PROVIDER=serverless
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=
OPENROUTER_VLM_MODEL=
SERVERLESS_BASE_URL=
SERVERLESS_API_KEY=
SERVERLESS_MODEL=
LLM_API_KEY=
POD_API_KEY=
# Optional manual override. Leave empty to use the RunPod locator.
POD_BASE_URL=
POD_MODEL=Qwen/Qwen3-VL-8B-Instruct
RUNPOD_API_KEY=
RUNPOD_POD_NAME_PREFIX=
RUNPOD_POD_PORT=8000
RUNPOD_LOOKUP_INTERVAL_SECONDS=30
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# /converse 한 턴 전체 상한(초). 개별 LLM 호출이 여러 번 연쇄될 수 있어 따로 둡니다
CONVERSE_TIMEOUT_SECONDS=115
# Optional Langfuse tracing. Set both keys and the URL for your Cloud region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set false to disable tracing without removing credentials.
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
VLM_MODEL=z-ai/glm-5.3-flash
S3_BUCKET=
AWS_REGION=ap-northeast-2
EMBEDDING_API_URL=http://embedding:8000
# 없으면 기동을 거부합니다 (settings.py의 REQUIRED_SETTINGS)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
# 인증을 켠 Qdrant에서만 채웁니다. 비우면 헤더 없이 접속합니다
QDRANT_API_KEY=
# 댓글 색인: 마스킹 뒤 답변이 이 글자 수보다 짧으면 색인하지 않습니다
COMMENT_MIN_CHARS=10
# 처리 결과를 받을 SQS 큐 URL. 비우면 통지를 보내지 않습니다
INDEXING_MAX_CONCURRENCY=2
# 평가 전용(run_m2.py). 운영 compose에는 절대 설정하지 않습니다
ALLOW_DATA_URL_IMAGES=false
LLM_JUDGE_MODEL=
# embedding 서비스: 한 번에 묶어 추론하는 색인 텍스트 수. 질의 최대 대기가 이 값에 비례해
# 늘어나므로 올릴 때는 질의 503을 함께 확인합니다. 주석 상태면 코드 기본값 1을 씁니다
# EMBEDDING_MAX_INDEX_BATCH=1
